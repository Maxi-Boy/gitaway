# Шаблон systemd-юнита: sudo systemctl enable --now gitaway@ИМЯ_ПОЛЬЗОВАТЕЛЯ
# Сервис работает от имени этого пользователя (как терминал после входа по SSH).
#
# Важно для режима PAM: не включайте NoNewPrivileges=yes, иначе вспомогательная
# программа unix_chkpwd (setuid) перестанет работать, и проверка пароля не пройдёт.
[Unit]
Description=gitaway web interface for %i
After=network.target

[Service]
User=%i
ExecStart=/usr/local/bin/gitaway -config /home/%i/.config/gitaway/config.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
